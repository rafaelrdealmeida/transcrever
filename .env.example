# Token HuggingFace (grátis) - necessário para diarização (identificação de falantes)
# 1. Crie em: https://huggingface.co/settings/tokens
# 2. Aceite o modelo pyannote: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# ─── Vast.ai (para transcrição via GPU remota) ─────────────────────────
# 1. Crie conta em https://cloud.vast.ai
# 2. Obtenha API key em https://cloud.vast.ai/account/
# 3. Registre sua chave SSH pública em https://cloud.vast.ai/account/
# 4. Execute: uv run python scripts/vastai_transcribe.py
VASTAI_API_KEY=

# Imagem Docker (PyTorch + CUDA)
VASTAI_IMAGE=pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime

# Espaço em disco na instância (GB)
VASTAI_DISK_GB=40

# Filtro de busca de GPU (sintaxe vastai search offers)
VASTAI_GPU_QUERY=num_gpus=1 gpu_ram>=12 cuda_max_good>=12.0 inet_down>100 dph_total<0.60

# ─── Transcrição ───────────────────────────────────────────────────────
# Modelo Whisper: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3

# Número de falantes por entrevista
NUM_SPEAKERS=2
